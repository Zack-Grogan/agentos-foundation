{
  "version": 1,
  "instances": [
    {
      "id": "my-api",
      "transport": "openai-chat",
      "enabled": false,
      "timeout_seconds": 60,
      "base_url": "https://your-authorized-endpoint.example/v1",
      "model": "replace-with-verified-model-id",
      "key_env": "AGENTOS_MODEL_API_KEY",
      "max_output_tokens": 2048
    },
    {
      "id": "my-agent",
      "transport": "acp",
      "enabled": false,
      "timeout_seconds": 120,
      "command": ["/replace/with/absolute/acp-executable"],
      "env_refs": {"HOME": "AGENTOS_NATIVE_PROFILE_HOME", "PATH": "PATH"},
      "scope_reviewed": false,
      "auth_owned_by_user": false
    }
  ]
}
