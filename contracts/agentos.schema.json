{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentOS architectural interchange contracts",
  "description": "Reference contracts for custom implementations, distinct from the minimal runtime records.",
  "oneOf": [
    {
      "$ref": "#/$defs/source"
    },
    {
      "$ref": "#/$defs/skill"
    },
    {
      "$ref": "#/$defs/routine"
    },
    {
      "$ref": "#/$defs/run"
    },
    {
      "$ref": "#/$defs/artifact"
    },
    {
      "$ref": "#/$defs/approval"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/layout"
    },
    {
      "$ref": "#/$defs/provider_instance"
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "digest": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "complete": {
          "type": "boolean"
        },
        "freshness": {
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        }
      },
      "required": [
        "id",
        "locator",
        "observed_at",
        "digest",
        "scope",
        "complete",
        "freshness"
      ]
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "input_schema": {
          "type": "string",
          "minLength": 1
        },
        "output_schema": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "revision",
        "entrypoint",
        "input_schema",
        "output_schema",
        "capabilities",
        "references"
      ]
    },
    "routine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "skill_id": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "schedule": {
          "type": "string",
          "minLength": 1
        },
        "missed_run_policy": {
          "enum": [
            "skip",
            "latest",
            "catch_up"
          ]
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "revision",
        "skill_id",
        "enabled",
        "timezone",
        "schedule",
        "missed_run_policy",
        "timeout_seconds",
        "max_attempts"
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "skill_id": {
          "type": "string",
          "minLength": 1
        },
        "skill_revision": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "blocked",
            "interrupted",
            "cancelled",
            "unknown"
          ]
        },
        "validation": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "request_id",
        "skill_id",
        "skill_revision",
        "source_ids",
        "status",
        "validation",
        "artifact_ids",
        "created_at"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "review": {
          "enum": [
            "not_required",
            "pending",
            "accepted",
            "rejected",
            "superseded"
          ]
        },
        "content": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "revision",
        "digest",
        "source_ids",
        "run_id",
        "review",
        "content"
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "target_revision": {
          "type": "integer",
          "minimum": 1
        },
        "target_digest": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "consumed": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "actor",
        "operation",
        "target_id",
        "target_revision",
        "target_digest",
        "expires_at",
        "consumed"
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "sequence",
        "run_id",
        "kind",
        "at",
        "payload"
      ]
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "widgets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "order": {
                "type": "integer",
                "minimum": 0
              },
              "size": {
                "enum": [
                  "compact",
                  "wide",
                  "full"
                ]
              },
              "visible": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "order",
              "size",
              "visible"
            ]
          }
        }
      },
      "required": [
        "workspace_id",
        "schema_version",
        "revision",
        "widgets"
      ]
    },
    "provider_instance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "driver": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "enum": [
            "acp",
            "codex-app-server",
            "openai-chat",
            "openai-responses",
            "anthropic-messages"
          ]
        },
        "auth_kind": {
          "type": "string",
          "minLength": 1
        },
        "billing_route": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification_state": {
          "enum": [
            "specified",
            "implemented",
            "tested-with-fixtures",
            "verified-live"
          ]
        }
      },
      "required": [
        "id",
        "driver",
        "transport",
        "auth_kind",
        "billing_route",
        "model_id",
        "capabilities",
        "verification_state"
      ]
    }
  }
}
